{
  "name": "@outskirts/schemas",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "The schema spine. Zod source of truth -> JSON Schema -> TS types, Pydantic models, constrained decoding, OpenAPI, plugin ToolSpec.",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "build": "tsx scripts/generate.ts",
    "check": "tsx scripts/generate.ts --check",
    "test": "vitest run",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.tools.json"
  },
  "dependencies": {
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8",
    "@types/node": "^22.10.2"
  }
}
