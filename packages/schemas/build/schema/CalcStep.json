{
  "$id": "https://outskirts.local/schema/CalcStep.json",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "ordinal": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "description": {
      "type": "string"
    },
    "expression": {
      "description": "SymPy-parseable, for C2 verification",
      "type": "string"
    },
    "result": {
      "type": "object",
      "properties": {
        "value": {
          "type": "number"
        },
        "unit": {
          "type": "string",
          "description": "Pint-parseable, e.g. \"m**3/h\", \"bar\", \"kg/m**3\""
        },
        "uncertainty": {
          "type": "number",
          "minimum": 0
        }
      },
      "required": [
        "value",
        "unit"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "ordinal",
    "description"
  ],
  "additionalProperties": false
}
