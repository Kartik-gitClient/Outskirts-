{
  "$id": "https://outskirts.local/schema/Chunk.json",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "chunkId": {
      "type": "string",
      "minLength": 1,
      "description": "Opaque identifier, unique within its collection"
    },
    "documentId": {
      "type": "string",
      "minLength": 1,
      "description": "Opaque identifier, unique within its collection"
    },
    "projectId": {
      "type": "string",
      "minLength": 1,
      "description": "Opaque identifier, unique within its collection"
    },
    "text": {
      "type": "string"
    },
    "ordinal": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "pageFrom": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "pageTo": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "embeddingModelId": {
      "type": "string",
      "minLength": 1
    },
    "dim": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    }
  },
  "required": [
    "chunkId",
    "documentId",
    "projectId",
    "text",
    "ordinal",
    "embeddingModelId",
    "dim"
  ],
  "additionalProperties": false
}
