{
  "$id": "https://outskirts.local/schema/ClaimVerdict.json",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "claimId": {
      "type": "string",
      "minLength": 1,
      "description": "Opaque identifier, unique within its collection"
    },
    "check": {
      "type": "string",
      "enum": [
        "C1_NUMERIC_GROUNDING",
        "C2_CALCULATION_REPLAY",
        "C3_CITATION_RESOLVABILITY",
        "C4_TEMPLATE_COMPLETENESS",
        "C5_FRESHNESS_POLICY",
        "C6_COHERENCE"
      ]
    },
    "pass": {
      "type": "boolean"
    },
    "offending": {
      "type": "string"
    },
    "note": {
      "type": "string"
    },
    "evidenceRef": {
      "description": "chunkId or calc transcript id backing this",
      "type": "string"
    }
  },
  "required": [
    "claimId",
    "check",
    "pass"
  ],
  "additionalProperties": false
}
