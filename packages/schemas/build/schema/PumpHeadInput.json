{
  "$id": "https://outskirts.local/schema/PumpHeadInput.json",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "flow": {
      "type": "object",
      "properties": {
        "value": {
          "type": "number"
        },
        "unit": {
          "type": "string",
          "description": "Pint-parseable, e.g. \"m**3/h\", \"bar\", \"kg/m**3\""
        },
        "uncertainty": {
          "type": "number",
          "minimum": 0
        }
      },
      "required": [
        "value",
        "unit"
      ],
      "additionalProperties": false
    },
    "density": {
      "type": "object",
      "properties": {
        "value": {
          "type": "number"
        },
        "unit": {
          "type": "string",
          "description": "Pint-parseable, e.g. \"m**3/h\", \"bar\", \"kg/m**3\""
        },
        "uncertainty": {
          "type": "number",
          "minimum": 0
        }
      },
      "required": [
        "value",
        "unit"
      ],
      "additionalProperties": false
    },
    "efficiency": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "head": {
      "type": "object",
      "properties": {
        "value": {
          "type": "number"
        },
        "unit": {
          "type": "string",
          "description": "Pint-parseable, e.g. \"m**3/h\", \"bar\", \"kg/m**3\""
        },
        "uncertainty": {
          "type": "number",
          "minimum": 0
        }
      },
      "required": [
        "value",
        "unit"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "flow",
    "density",
    "efficiency"
  ],
  "additionalProperties": false
}
