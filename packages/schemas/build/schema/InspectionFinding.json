{
  "$id": "https://outskirts.local/schema/InspectionFinding.json",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "findingId": {
      "type": "string",
      "minLength": 1,
      "description": "Opaque identifier, unique within its collection"
    },
    "equipmentTag": {
      "type": "string",
      "description": "e.g. P-101A"
    },
    "description": {
      "type": "string"
    },
    "measuredValue": {
      "type": "number"
    },
    "measuredUnit": {
      "type": "string"
    },
    "limitValue": {
      "type": "number"
    },
    "limitUnit": {
      "type": "string"
    },
    "severity": {
      "type": "string",
      "enum": [
        "observation",
        "minor",
        "major",
        "critical"
      ]
    },
    "sourceBlockId": {
      "description": "Links the finding back to its region on the page",
      "type": "string",
      "minLength": 1
    }
  },
  "required": [
    "findingId",
    "equipmentTag",
    "description",
    "severity"
  ],
  "additionalProperties": false
}
