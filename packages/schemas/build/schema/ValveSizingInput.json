{
  "$id": "https://outskirts.local/schema/ValveSizingInput.json",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "flowRate": {
      "type": "object",
      "properties": {
        "value": {
          "type": "number"
        },
        "unit": {
          "type": "string",
          "description": "Pint-parseable, e.g. \"m**3/h\", \"bar\", \"kg/m**3\""
        },
        "uncertainty": {
          "type": "number",
          "minimum": 0
        }
      },
      "required": [
        "value",
        "unit"
      ],
      "additionalProperties": false
    },
    "deltaP": {
      "type": "object",
      "properties": {
        "value": {
          "type": "number"
        },
        "unit": {
          "type": "string",
          "description": "Pint-parseable, e.g. \"m**3/h\", \"bar\", \"kg/m**3\""
        },
        "uncertainty": {
          "type": "number",
          "minimum": 0
        }
      },
      "required": [
        "value",
        "unit"
      ],
      "additionalProperties": false
    },
    "specificGravity": {
      "default": 0.85,
      "type": "number",
      "exclusiveMinimum": 0
    }
  },
  "required": [
    "flowRate",
    "deltaP"
  ],
  "additionalProperties": false
}
