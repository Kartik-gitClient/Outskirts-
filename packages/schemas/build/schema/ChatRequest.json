{
  "$id": "https://outskirts.local/schema/ChatRequest.json",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "taskId": {
      "type": "string",
      "minLength": 1,
      "description": "Opaque identifier, unique within its collection"
    },
    "stepId": {
      "type": "string",
      "minLength": 1,
      "description": "Opaque identifier, unique within its collection"
    },
    "taskType": {
      "type": "string",
      "enum": [
        "code",
        "document",
        "vision",
        "calculation",
        "retrieve"
      ],
      "description": "Step type; drives routing"
    },
    "messages": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "role": {
            "type": "string",
            "enum": [
              "system",
              "user",
              "assistant",
              "tool"
            ]
          },
          "content": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "toolCallId": {
            "type": "string",
            "minLength": 1,
            "description": "Opaque identifier, unique within its collection"
          }
        },
        "required": [
          "role",
          "content"
        ],
        "additionalProperties": false
      }
    },
    "toolNames": {
      "default": [],
      "description": "Allowlist; the step may invoke no others",
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "outputSchemaRef": {
      "type": "string",
      "minLength": 1,
      "description": "Name of a schema in @outskirts/schemas, e.g. \"ExtractionResult\""
    },
    "seed": {
      "default": null,
      "anyOf": [
        {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        },
        {
          "type": "null"
        }
      ]
    },
    "temperature": {
      "default": 0,
      "type": "number",
      "minimum": 0,
      "maximum": 2
    },
    "maxTokens": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "stream": {
      "default": false,
      "type": "boolean"
    }
  },
  "required": [
    "taskId",
    "stepId",
    "taskType",
    "messages"
  ],
  "description": "A provider-agnostic inference request. The only shape the PAL accepts.",
  "additionalProperties": false
}
