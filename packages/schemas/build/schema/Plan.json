{
  "$id": "https://outskirts.local/schema/Plan.json",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "taskId": {
      "type": "string",
      "minLength": 1,
      "description": "Opaque identifier, unique within its collection"
    },
    "recipeId": {
      "description": "Absent when the free-form planner produced this",
      "type": "string",
      "minLength": 1
    },
    "steps": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "stepId": {
            "type": "string",
            "minLength": 1,
            "description": "Opaque identifier, unique within its collection"
          },
          "kind": {
            "type": "string",
            "enum": [
              "code",
              "document",
              "vision",
              "calculation",
              "retrieve"
            ],
            "description": "Step type; drives routing"
          },
          "description": {
            "type": "string",
            "minLength": 1,
            "description": "Planner's natural-language intent"
          },
          "dependsOn": {
            "default": [],
            "description": "Step ids; validated acyclic and reachable",
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "description": "Opaque identifier, unique within its collection"
            }
          },
          "plugins": {
            "default": [],
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "outputSchemaRef": {
            "type": "string",
            "minLength": 1,
            "description": "Name of a schema in @outskirts/schemas, e.g. \"ExtractionResult\""
          },
          "status": {
            "default": "pending",
            "type": "string",
            "enum": [
              "pending",
              "running",
              "done",
              "failed",
              "repaired",
              "cancelled"
            ]
          }
        },
        "required": [
          "stepId",
          "kind",
          "description"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "taskId",
    "steps"
  ],
  "additionalProperties": false
}
