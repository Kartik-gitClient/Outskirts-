{
  "$id": "https://outskirts.local/schema/ChatMessage.json",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "role": {
      "type": "string",
      "enum": [
        "system",
        "user",
        "assistant",
        "tool"
      ]
    },
    "content": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "toolCallId": {
      "type": "string",
      "minLength": 1,
      "description": "Opaque identifier, unique within its collection"
    }
  },
  "required": [
    "role",
    "content"
  ],
  "additionalProperties": false
}
