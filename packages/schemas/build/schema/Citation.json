{
  "$id": "https://outskirts.local/schema/Citation.json",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "citationId": {
      "type": "string",
      "minLength": 1,
      "description": "Opaque identifier, unique within its collection"
    },
    "chunkId": {
      "type": "string",
      "minLength": 1,
      "description": "Opaque identifier, unique within its collection"
    },
    "documentId": {
      "type": "string",
      "minLength": 1,
      "description": "Opaque identifier, unique within its collection"
    },
    "quote": {
      "type": "string"
    },
    "decayAtCitation": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "stateAtCitation": {
      "type": "string",
      "enum": [
        "FRESH",
        "AGING",
        "STALE",
        "CRITICAL",
        "RECORD",
        "UNVERIFIED"
      ]
    },
    "acknowledgedBy": {
      "description": "Required when stateAtCitation is CRITICAL",
      "type": "string",
      "minLength": 1
    },
    "acknowledgedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$",
      "description": "ISO 8601 timestamp, UTC"
    },
    "bbox": {
      "type": "object",
      "properties": {
        "page": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "x": {
          "type": "number"
        },
        "y": {
          "type": "number"
        },
        "w": {
          "type": "number"
        },
        "h": {
          "type": "number"
        }
      },
      "required": [
        "page",
        "x",
        "y",
        "w",
        "h"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "citationId",
    "chunkId",
    "documentId",
    "quote",
    "decayAtCitation",
    "stateAtCitation"
  ],
  "additionalProperties": false
}
