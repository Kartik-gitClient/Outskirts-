{
  "$id": "https://outskirts.local/schema/ChainAnchor.json",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "anchorId": {
      "type": "string",
      "minLength": 1,
      "description": "Opaque identifier, unique within its collection"
    },
    "seqLow": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991,
      "description": "Monotonic sequence number, per task"
    },
    "seqHigh": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991,
      "description": "Monotonic sequence number, per task"
    },
    "eventCount": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "merkleRoot": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$",
      "description": "Lowercase hex SHA-256 digest"
    },
    "prevAnchorHash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$",
      "description": "Lowercase hex SHA-256 digest"
    },
    "prevAnchorSignature": {
      "type": "string"
    },
    "signature": {
      "type": "string"
    },
    "keyId": {
      "type": "string",
      "minLength": 1
    },
    "signedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$",
      "description": "ISO 8601 timestamp, UTC"
    }
  },
  "required": [
    "anchorId",
    "seqLow",
    "seqHigh",
    "eventCount",
    "merkleRoot",
    "prevAnchorHash",
    "prevAnchorSignature",
    "signature",
    "keyId",
    "signedAt"
  ],
  "additionalProperties": false
}
