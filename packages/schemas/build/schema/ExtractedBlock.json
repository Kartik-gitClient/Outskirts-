{
  "$id": "https://outskirts.local/schema/ExtractedBlock.json",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "blockId": {
      "type": "string",
      "minLength": 1,
      "description": "Opaque identifier, unique within its collection"
    },
    "category": {
      "type": "string",
      "enum": [
        "title",
        "section-header",
        "text",
        "list-item",
        "table",
        "figure",
        "formula",
        "caption",
        "page-header",
        "page-footer",
        "footnote"
      ]
    },
    "text": {
      "type": "string"
    },
    "bbox": {
      "type": "object",
      "properties": {
        "page": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "x": {
          "type": "number",
          "minimum": 0
        },
        "y": {
          "type": "number",
          "minimum": 0
        },
        "w": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "h": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      },
      "required": [
        "page",
        "x",
        "y",
        "w",
        "h"
      ],
      "additionalProperties": false
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    }
  },
  "required": [
    "blockId",
    "category",
    "text",
    "bbox"
  ],
  "additionalProperties": false
}
