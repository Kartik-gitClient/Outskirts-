{
  "$id": "https://outskirts.local/schema/ExtractionResult.json",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "documentId": {
      "type": "string",
      "minLength": 1,
      "description": "Opaque identifier, unique within its collection"
    },
    "engine": {
      "type": "string",
      "description": "e.g. paddleocr-vl-1.6"
    },
    "pageCount": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "blocks": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "blockId": {
            "type": "string",
            "minLength": 1,
            "description": "Opaque identifier, unique within its collection"
          },
          "category": {
            "type": "string",
            "enum": [
              "title",
              "section-header",
              "text",
              "list-item",
              "table",
              "figure",
              "formula",
              "caption",
              "page-header",
              "page-footer",
              "footnote"
            ]
          },
          "text": {
            "type": "string"
          },
          "bbox": {
            "type": "object",
            "properties": {
              "page": {
                "type": "integer",
                "exclusiveMinimum": 0,
                "maximum": 9007199254740991
              },
              "x": {
                "type": "number",
                "minimum": 0
              },
              "y": {
                "type": "number",
                "minimum": 0
              },
              "w": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "h": {
                "type": "number",
                "exclusiveMinimum": 0
              }
            },
            "required": [
              "page",
              "x",
              "y",
              "w",
              "h"
            ],
            "additionalProperties": false
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          }
        },
        "required": [
          "blockId",
          "category",
          "text",
          "bbox"
        ],
        "additionalProperties": false
      }
    },
    "tablesHtml": {
      "default": [],
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "blockId": {
            "type": "string",
            "minLength": 1,
            "description": "Opaque identifier, unique within its collection"
          },
          "html": {
            "type": "string"
          }
        },
        "required": [
          "blockId",
          "html"
        ],
        "additionalProperties": false
      }
    },
    "formulasLatex": {
      "default": [],
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "blockId": {
            "type": "string",
            "minLength": 1,
            "description": "Opaque identifier, unique within its collection"
          },
          "latex": {
            "type": "string"
          }
        },
        "required": [
          "blockId",
          "latex"
        ],
        "additionalProperties": false
      }
    },
    "readingOrder": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "description": "Opaque identifier, unique within its collection"
      },
      "description": "blockIds in human reading order"
    }
  },
  "required": [
    "documentId",
    "engine",
    "pageCount",
    "blocks",
    "readingOrder"
  ],
  "additionalProperties": false
}
