{
  "$id": "https://outskirts.local/schema/PluginManifest.json",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*$"
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "minCore": {
      "type": "string",
      "description": "semver range checked against the runtime version"
    },
    "runtime": {
      "type": "string",
      "enum": [
        "wasm",
        "service",
        "iframe"
      ]
    },
    "entry": {
      "type": "string",
      "description": "Worker module, image ref, or entry URL depending on runtime"
    },
    "network": {
      "type": "string",
      "const": "deny-all"
    },
    "fs": {
      "type": "object",
      "properties": {
        "read": {
          "default": [],
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "write": {
          "default": [],
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "resources": {
      "type": "object",
      "properties": {
        "cpu": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "mem": {
          "type": "string",
          "pattern": "^\\d+[MG]$"
        },
        "timeoutS": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "cpu",
        "mem",
        "timeoutS"
      ],
      "additionalProperties": false
    },
    "tools": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "description": {
            "type": "string",
            "minLength": 1,
            "description": "Offered to the planner; write it for a model to read"
          },
          "inputSchemaRef": {
            "type": "string",
            "minLength": 1,
            "description": "Name of a schema in @outskirts/schemas, e.g. \"ExtractionResult\""
          },
          "outputSchemaRef": {
            "type": "string",
            "minLength": 1,
            "description": "Name of a schema in @outskirts/schemas, e.g. \"ExtractionResult\""
          }
        },
        "required": [
          "name",
          "description",
          "inputSchemaRef",
          "outputSchemaRef"
        ],
        "additionalProperties": false
      }
    },
    "keyId": {
      "type": "string",
      "minLength": 1
    },
    "signature": {
      "type": "string",
      "pattern": "^ed25519:[a-f0-9]+$"
    }
  },
  "required": [
    "id",
    "version",
    "minCore",
    "runtime",
    "entry",
    "network",
    "fs",
    "resources",
    "tools",
    "keyId",
    "signature"
  ],
  "additionalProperties": false
}
