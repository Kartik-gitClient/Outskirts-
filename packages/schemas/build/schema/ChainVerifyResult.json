{
  "$id": "https://outskirts.local/schema/ChainVerifyResult.json",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "valid": {
      "type": "boolean"
    },
    "eventsWalked": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "anchorsVerified": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "brokenAtSeq": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991,
      "description": "Monotonic sequence number, per task"
    },
    "reason": {
      "type": "string",
      "enum": [
        "hash-mismatch",
        "signature-invalid",
        "count-mismatch",
        "anchor-gap",
        "untrusted-key"
      ]
    },
    "checkedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$",
      "description": "ISO 8601 timestamp, UTC"
    }
  },
  "required": [
    "valid",
    "eventsWalked",
    "anchorsVerified",
    "checkedAt"
  ],
  "additionalProperties": false
}
