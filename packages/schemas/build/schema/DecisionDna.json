{
  "$id": "https://outskirts.local/schema/DecisionDna.json",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "dnaId": {
      "type": "string",
      "minLength": 1,
      "description": "Opaque identifier, unique within its collection"
    },
    "taskId": {
      "type": "string",
      "minLength": 1,
      "description": "Opaque identifier, unique within its collection"
    },
    "goal": {
      "type": "string"
    },
    "recipeId": {
      "type": "string",
      "minLength": 1,
      "description": "Opaque identifier, unique within its collection"
    },
    "modeAtLaunch": {
      "type": "string",
      "enum": [
        "SOVEREIGN",
        "ASSIST"
      ]
    },
    "planHash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$",
      "description": "Lowercase hex SHA-256 digest"
    },
    "steps": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "stepId": {
            "type": "string",
            "minLength": 1,
            "description": "Opaque identifier, unique within its collection"
          },
          "kind": {
            "type": "string"
          },
          "model": {
            "type": "string"
          },
          "modelDigest": {
            "type": "string"
          },
          "providerId": {
            "type": "string"
          },
          "locality": {
            "type": "string"
          },
          "trustBoundary": {
            "type": "string"
          },
          "promptTemplateHash": {
            "type": "string"
          },
          "seed": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": -9007199254740991,
                "maximum": 9007199254740991
              },
              {
                "type": "null"
              }
            ]
          },
          "toolCalls": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "tool": {
                  "type": "string"
                },
                "inputHash": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$",
                  "description": "Lowercase hex SHA-256 digest"
                },
                "outputHash": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$",
                  "description": "Lowercase hex SHA-256 digest"
                }
              },
              "required": [
                "tool",
                "inputHash",
                "outputHash"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "stepId",
          "kind",
          "model",
          "modelDigest",
          "providerId",
          "locality",
          "trustBoundary",
          "promptTemplateHash",
          "seed",
          "toolCalls"
        ],
        "additionalProperties": false
      }
    },
    "citations": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "citationId": {
            "type": "string",
            "minLength": 1,
            "description": "Opaque identifier, unique within its collection"
          },
          "documentId": {
            "type": "string",
            "minLength": 1,
            "description": "Opaque identifier, unique within its collection"
          },
          "decayAtCitation": {
            "type": "number"
          },
          "stateAtCitation": {
            "type": "string"
          }
        },
        "required": [
          "citationId",
          "documentId",
          "decayAtCitation",
          "stateAtCitation"
        ],
        "additionalProperties": false
      }
    },
    "criticGate": {
      "type": "string",
      "enum": [
        "pass",
        "fail"
      ]
    },
    "deterministicPass": {
      "type": "boolean"
    },
    "overrides": {
      "default": [],
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "actorId": {
            "type": "string",
            "minLength": 1,
            "description": "Opaque identifier, unique within its collection"
          },
          "at": {
            "type": "string",
            "format": "date-time",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$",
            "description": "ISO 8601 timestamp, UTC"
          },
          "note": {
            "type": "string"
          }
        },
        "required": [
          "actorId",
          "at",
          "note"
        ],
        "additionalProperties": false
      }
    },
    "artifactHashes": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-f0-9]{64}$",
        "description": "Lowercase hex SHA-256 digest"
      }
    },
    "c2paManifestRef": {
      "type": "string"
    },
    "chainSeqLow": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991,
      "description": "Monotonic sequence number, per task"
    },
    "chainSeqHigh": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991,
      "description": "Monotonic sequence number, per task"
    }
  },
  "required": [
    "dnaId",
    "taskId",
    "goal",
    "modeAtLaunch",
    "planHash",
    "steps",
    "citations",
    "criticGate",
    "deterministicPass",
    "artifactHashes",
    "chainSeqLow",
    "chainSeqHigh"
  ],
  "additionalProperties": false
}
