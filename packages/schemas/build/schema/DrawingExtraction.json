{
  "$id": "https://outskirts.local/schema/DrawingExtraction.json",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "documentId": {
      "type": "string",
      "minLength": 1,
      "description": "Opaque identifier, unique within its collection"
    },
    "sheetNumber": {
      "type": "string"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "tagId": {
            "type": "string",
            "minLength": 1,
            "description": "Opaque identifier, unique within its collection"
          },
          "tagNumber": {
            "type": "string"
          },
          "symbolClass": {
            "type": "string",
            "description": "ISA-5.1 class, e.g. gate-valve, centrifugal-pump"
          },
          "bbox": {
            "type": "object",
            "properties": {
              "page": {
                "type": "integer",
                "exclusiveMinimum": 0,
                "maximum": 9007199254740991
              },
              "x": {
                "type": "number",
                "minimum": 0
              },
              "y": {
                "type": "number",
                "minimum": 0
              },
              "w": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "h": {
                "type": "number",
                "exclusiveMinimum": 0
              }
            },
            "required": [
              "page",
              "x",
              "y",
              "w",
              "h"
            ],
            "additionalProperties": false
          },
          "detectorConfidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "ocrConfidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "lineNumber": {
            "type": "string"
          }
        },
        "required": [
          "tagId",
          "tagNumber",
          "symbolClass",
          "bbox",
          "detectorConfidence"
        ],
        "additionalProperties": false
      }
    },
    "connections": {
      "default": [],
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "fromTagId": {
            "type": "string",
            "minLength": 1,
            "description": "Opaque identifier, unique within its collection"
          },
          "toTagId": {
            "type": "string",
            "minLength": 1,
            "description": "Opaque identifier, unique within its collection"
          },
          "lineNumber": {
            "type": "string"
          }
        },
        "required": [
          "fromTagId",
          "toTagId"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "documentId",
    "tags"
  ],
  "additionalProperties": false
}
